; Engine configuration file.
; Credia Guardians ??? retro 16-bit platformer. See docs/TDD.md for the meaning
; of every setting in this file.

config_version=5

[application]

config/name="Credia Guardians"
config/description="Two developers defend the Credia banking system from corrupted bankers."
config/version="1.1.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
GameManager="*res://src/autoload/game_manager.gd"
SaveManager="*res://src/autoload/save_manager.gd"
AudioManager="*res://src/autoload/audio_manager.gd"
SceneManager="*res://src/autoload/scene_manager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

