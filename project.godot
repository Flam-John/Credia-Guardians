[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_hitbox"
2d_physics/layer_5="enemy_hurtbox"
2d_physics/layer_6="enemy_hitbox"
2d_physics/layer_7="player_hurtbox"
2d_physics/layer_8="collectible"
2d_physics/layer_9="platform_oneway"
2d_physics/layer_10="hazard"
2d_physics/layer_11="trigger"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0196078, 0.0392157, 0.0705882, 1)
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
