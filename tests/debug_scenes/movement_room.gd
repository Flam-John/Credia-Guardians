extends Node2D
## Movement debug room: ledge/gap gauntlet built from ASCII (versionable).
## M0: renders geometry + static camera. M1 adds the player (keys 1/2 swap
## Chris/Flam).

const ROOM_MAP := """
@..............................................................@
@..............................................................@
@..............................................................@
@.......................................................####...@
@..............................................................@
@..................................................####........@
@...........................................###................@
@..............-----...........................................@
@.......................######.................................@
@...####........................................####...........@
@..............................................................@
@.....................##.......................................@
@############.....########....#####....^^^....##################
@@@@@@@@@@@@@.....@@@@@@@@....@@@@@....................@@@@@@@@@
"""


func _ready() -> void:
	var builder := AsciiRoomBuilder.new()
	builder.map = ROOM_MAP
	add_child(builder)
	builder.build()

	var camera := Camera2D.new()
	camera.position = builder.room_size / 2.0
	camera.limit_left = 0
	camera.limit_top = 0
	camera.limit_right = int(builder.room_size.x)
	camera.limit_bottom = int(builder.room_size.y)
	add_child(camera)
	camera.make_current()
